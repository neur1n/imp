SET(prefix "${DIRECTORY}/prefix")
FILE(MAKE_DIRECTORY "${prefix}/bin")
FILE(REMOVE "${prefix}/bin/imp.conf")

FUNCTION(install_to target)
  EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${target}" --config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  IF(NOT result EQUAL 0)
    MESSAGE(FATAL_ERROR "Install failed: ${output} ${error}")
  ENDIF()
ENDFUNCTION()

install_to("${prefix}")
FILE(READ "${PRESET}" expected)
FILE(READ "${prefix}/bin/imp.conf" actual)
IF(NOT actual STREQUAL expected)
  MESSAGE(FATAL_ERROR "First install must include the preset configuration")
ENDIF()

FILE(WRITE "${prefix}/bin/imp.conf" "user custom.alpha custom.native\n")
install_to("${prefix}")
FILE(READ "${prefix}/bin/imp.conf" actual)
IF(NOT actual STREQUAL "user custom.alpha custom.native\n")
  MESSAGE(FATAL_ERROR "Reinstall overwrote the user's configuration")
ENDIF()

IF(UNIX)
  SET(ENV{DESTDIR} "${DIRECTORY}/stage")
  FILE(REMOVE "${DIRECTORY}/stage/imp-test/bin/imp.conf")
  install_to("/imp-test")
  FILE(READ "${DIRECTORY}/stage/imp-test/bin/imp.conf" actual)
  IF(NOT actual STREQUAL expected)
    MESSAGE(FATAL_ERROR "Staged install must include the preset at the correct path")
  ENDIF()
  FILE(WRITE "${DIRECTORY}/stage/imp-test/bin/imp.conf" "staged custom.alpha custom.native\n")
  install_to("/imp-test")
  FILE(READ "${DIRECTORY}/stage/imp-test/bin/imp.conf" actual)
  IF(NOT actual STREQUAL "staged custom.alpha custom.native\n")
    MESSAGE(FATAL_ERROR "Staged reinstall overwrote the user's configuration")
  ENDIF()
ENDIF()
